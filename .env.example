# Copiá este archivo a ".env" y completá los valores reales. NUNCA subas el .env
# real a ningún repositorio ni lo compartas: tiene credenciales.

# Connection string de Postgres (Neon, pooled — sufijo "-pooler"). Si se deja vacío,
# la app usa SQLite local en instance/docreview.db (solo para pruebas sin nube).
DATABASE_URL=postgresql://usuario:password@ep-xxxx-pooler.region.aws.neon.tech/docreview?sslmode=require

# Clave secreta de Flask (sesiones/CSRF). Generar una única y larga, por ejemplo con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-esto-por-una-clave-generada

# Poné "1" SOLO en el .env local del administrador, en una PC con VPN FortiClient y
# acceso a T:\. Dejar sin esta variable (o en "0") en el deploy de Render, para
# ocultar y bloquear Importar/Mover a servidor/Correos en esa instancia.
ENABLE_LOCAL_FILE_OPS=1

# Usados solo una vez por el comando "flask seed-admin" para crear el primer admin.
# No hace falta dejarlos seteados de forma permanente.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
